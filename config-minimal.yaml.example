# Nova Agent — Minimal Configuration
#
# The bare minimum to get started. Copy to config.yaml and set your API key.
#
# Usage:
#   cp config-minimal.yaml.example config.yaml
#   # Edit config.yaml with your API key
#   nova chat

llm:
  api_key: "${LLM_API_KEY}"  # Set LLM_API_KEY env var, or put key here directly
  model: "qwen/qwen3.6-flash"
  base_url: "https://openrouter.ai/api/v1"  # any OpenAI-compatible endpoint

# Firecrawl web tools (search/scrape/crawl/extract). Needs an API key and
# pip install 'nova-agent[web]'; omit this section to leave them off.
# web:
#   firecrawl_api_key: "${FIRECRAWL_API_KEY}"
